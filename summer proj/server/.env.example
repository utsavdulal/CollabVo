# -- Server ---------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# -- Database -------------------------------------------------------------------
# Replace with your MongoDB Atlas connection string or local MongoDB
# Atlas:  mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/collavo?retryWrites=true&w=majority
# Local:  mongodb://localhost:27017/collavo
MONGO_URI=mongodb://localhost:27017/collavo

# -- JWT Secrets ----------------------------------------------------------------
JWT_ACCESS_SECRET=change_this_to_a_long_random_secret_access
JWT_REFRESH_SECRET=change_this_to_a_long_random_secret_refresh

# -- CORS -----------------------------------------------------------------------
CLIENT_ORIGIN=http://localhost:5173
ADMIN_CLIENT_ORIGIN=http://localhost:5174

# -- Admin account --------------------------------------------------------------
ADMIN_EMAIL=admin@collavo.app
ADMIN_PASSWORD=AdminPass123!

# -- Azure Blob (leave empty to use local disk in dev) --------------------------
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_PRIVATE_CONTAINER=collavo-private

# -- Google Gemini (AI proposal generation) -------------------------------------
# Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-flash-lite-latest
