# Copy to .env.production (or set these in Azure App Service -> Configuration)
# Replace every <...> value below.

PORT=8080
NODE_ENV=production

# MongoDB Atlas connection string (step 1 of setup)
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=<long-random-string>
JWT_REFRESH_SECRET=<another-long-random-string>

# Same-origin in production, but keep the list accurate for CORS
CLIENT_ORIGIN=https://<your-app>.azurewebsites.net
ADMIN_CLIENT_ORIGIN=https://<your-app>.azurewebsites.net

# Admin panel route (keep it obscure; do not use a guessable word)
ADMIN_ROUTE_PATH=ops-9f3k2

# Optional: Google sign-in. Leave unset to disable Google login entirely.
# GOOGLE_CLIENT_ID=<your-client-id>
# GOOGLE_CLIENT_SECRET=<your-client-secret>
# GOOGLE_CALLBACK_URL=https://<your-app>.azurewebsites.net/api/auth/google/callback

# Optional: Azure Blob for uploaded files. Without it, uploads go to local disk.
# AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=...
# AZURE_BLOB_PRIVATE_CONTAINER=collavo-private

# Optional: Azure Key Vault for secrets.
# AZURE_KEYVAULT_URL=https://<your-vault>.vault.azure.net

# Escrow auto-release after creator confirms completion (days)
ESCROW_AUTO_RELEASE_DAYS=7

# Google Gemini (AI proposal generation). Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=<your-gemini-api-key>
# GEMINI_MODEL=gemini-flash-lite-latest
